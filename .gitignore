# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Model weights ----
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
checkpoints/
/weights/*
!/weights/.gitkeep

# ---- Video / working data ----
# Directories are kept in git via .gitkeep; their contents are not.
/data/*
!/data/.gitkeep
!/data/raw/
/data/raw/*
!/data/raw/.gitkeep
!/data/samples/
/data/samples/*
!/data/samples/.gitkeep
/outputs/*
!/outputs/.gitkeep
tmp/

# Media files anywhere (demo clips, proxies, renders)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3

# ---- Node / frontend ----
node_modules/
.next/
dist/
build/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
