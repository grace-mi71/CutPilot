# Copy to .env and fill in. .env is gitignored; this file is not.
# Every key is optional except the API key -- defaults live in core/config.py.

# ---- LLM ----------------------------------------------------------------
# https://aistudio.google.com/apikey
CUTPILOT_GEMINI_API_KEY=

# Pin the model. Week 11 compares three interaction conditions against each
# other; a model that shifts mid-evaluation invalidates the comparison.
CUTPILOT_GEMINI_MODEL=gemini-2.5-flash

# Cached replies keep benchmarks reproducible and off the rate limit.
CUTPILOT_LLM_CACHE_ENABLED=true

# ---- Inference ----------------------------------------------------------
# auto | cuda | cpu. "auto" falls back to cpu unless a CUDA kernel for this
# card's architecture is actually present in the torch build.
CUTPILOT_DEVICE=auto
CUTPILOT_DETECT_CONFIDENCE=0.35

# ---- Ingest -------------------------------------------------------------
CUTPILOT_PROXY_HEIGHT=480
CUTPILOT_SPRITE_INTERVAL=1.0
CUTPILOT_MAX_VIDEO_SECONDS=180
